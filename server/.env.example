PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://user:pass@host:5432/garaje_peru
JWT_SECRET=cambia-esto-minimo-32-caracteres-aleatorios
# En producción: dominios exactos de tus frontends, coma-separados
FRONT_URL=http://localhost:5173,http://localhost:5174
TZ=America/Lima
ADMIN_EMAIL=admin@garajes.pe
ADMIN_PASSWORD=Admin123!
# Códigos de verificación visibles en respuesta (solo demo local). En prod: false + SMTP real
ALLOW_DEMO_CODES=true
# Correo real (ej. Resend/Brevo gratis). Sin esto, modo demo en consola
# Opción A (recomendada en Render): Brevo por API HTTP - gratis 300/día, sin dominio
#BREVO_API_KEY=xkeysib-...
#BREVO_FROM=tu-correo@tudominio.pe
# Opción B: SMTP clásico (ojo: Render bloquea Gmail SMTP)
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=resend
#SMTP_PASS=tu-api-key
#SMTP_FROM=Garajes Perú <no-reply@tudominio.pe>
